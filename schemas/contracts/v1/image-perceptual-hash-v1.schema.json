{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontextpack.local/schemas/contracts/v1/image-perceptual-hash-v1.schema.json",
  "title": "ImagePerceptualHashV1",
  "$comment": "Structural V1 schema. Cross-field semantic authority: src/domain/validation.ts#isImagePerceptualHashV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "hash",
    "sampleWidth",
    "sampleHeight",
    "orientationApplied",
    "durationMs",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "algorithm": { "const": "dhash-64-v1" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{16}$" },
    "sampleWidth": { "const": 9 },
    "sampleHeight": { "const": 8 },
    "orientationApplied": { "const": true },
    "durationMs": { "type": "number", "minimum": 0 },
    "revision": { "const": "1" }
  }
}
