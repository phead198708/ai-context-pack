{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontextpack.local/schemas/contracts/v1/risk-finding-v1.schema.json",
  "title": "RiskFindingV1",
  "$comment": "Structural V1 schema. Cross-field semantic authority: src/domain/validation.ts#isRiskFindingV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "itemId",
    "detector",
    "detectorVersion",
    "category",
    "severity",
    "confidence",
    "location",
    "decision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "itemId": { "$ref": "#/$defs/uuid" },
    "detector": { "type": "string", "minLength": 1 },
    "detectorVersion": { "type": "string", "minLength": 1 },
    "category": {
      "enum": [
        "api-key",
        "bearer-token",
        "jwt",
        "private-key",
        "url-credential",
        "email",
        "phone",
        "ip-address",
        "payment-card"
      ]
    },
    "severity": { "enum": ["low", "medium", "high"] },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "location": {
      "oneOf": [
        { "$ref": "#/$defs/textRange" },
        { "$ref": "#/$defs/imageRegion" }
      ]
    },
    "decision": { "enum": ["pending", "keep", "redact"] }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "textRange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "start", "length"],
      "properties": {
        "kind": { "const": "text-range" },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      }
    },
    "imageRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "x", "y", "width", "height"],
      "properties": {
        "kind": { "const": "image-region" },
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
      }
    }
  }
}
