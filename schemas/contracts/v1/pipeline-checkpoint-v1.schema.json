{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontextpack.local/schemas/contracts/v1/pipeline-checkpoint-v1.schema.json",
  "title": "PipelineCheckpointV1",
  "$comment": "Structural V1 schema. Cross-field semantic authority: src/domain/validation.ts#isPipelineCheckpointV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "runId",
    "packId",
    "stage",
    "reason",
    "resumeAction",
    "completedArtifactIds",
    "processor",
    "processorVersion",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/uuid" },
    "runId": { "$ref": "#/$defs/uuid" },
    "packId": { "$ref": "#/$defs/uuid" },
    "itemId": { "$ref": "#/$defs/uuid" },
    "stage": { "enum": ["import", "extract", "analyze", "review", "package"] },
    "reason": {
      "enum": [
        "periodic",
        "backgrounded",
        "cancelled",
        "stage-failure",
        "recovery"
      ]
    },
    "resumeAction": {
      "enum": ["continue", "retry-stage", "recover-stage"]
    },
    "completedArtifactIds": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/uuid" }
    },
    "processor": { "type": "string", "minLength": 1 },
    "processorVersion": { "type": "string", "minLength": 1 },
    "updatedAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "errorCode": { "$ref": "#/$defs/errorCode" }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "reason": { "enum": ["periodic", "backgrounded"] }
        },
        "required": ["reason"]
      },
      "then": {
        "properties": { "resumeAction": { "const": "continue" } },
        "not": {
          "properties": { "errorCode": true },
          "required": ["errorCode"]
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "cancelled" } },
        "required": ["reason"]
      },
      "then": {
        "properties": { "resumeAction": { "const": "retry-stage" } },
        "not": {
          "properties": { "errorCode": true },
          "required": ["errorCode"]
        }
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "stage-failure" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "resumeAction": { "const": "retry-stage" },
          "errorCode": { "$ref": "#/$defs/errorCode" }
        },
        "required": ["errorCode"]
      }
    },
    {
      "if": {
        "properties": { "reason": { "const": "recovery" } },
        "required": ["reason"]
      },
      "then": {
        "properties": {
          "resumeAction": { "const": "recover-stage" },
          "errorCode": { "$ref": "#/$defs/errorCode" }
        },
        "required": ["errorCode"]
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "errorCode": {
      "enum": [
        "DOMAIN_INVALID_TRANSITION",
        "SCHEMA_INVALID",
        "SCHEMA_VERSION_UNSUPPORTED",
        "ARTIFACT_INTEGRITY_FAILED",
        "IMPORT_PROVIDER_PERMISSION_EXPIRED",
        "IMPORT_TYPE_UNSUPPORTED",
        "IMPORT_COPY_FAILED",
        "IMPORT_SIZE_LIMIT_EXCEEDED",
        "IMPORT_ITEM_LIMIT_EXCEEDED",
        "IMPORT_PARTIAL_FAILURE",
        "PDF_CANCELLED",
        "PDF_CORRUPT",
        "PDF_ENCRYPTED",
        "PDF_EMPTY",
        "PDF_TOO_LARGE",
        "PDF_TOO_MANY_PAGES",
        "PDF_PAGE_OUT_OF_RANGE",
        "PDF_PAGE_EXTRACTION_FAILED",
        "PDF_RESOURCE_BUSY",
        "PDF_RESULT_INVALID",
        "TEXT_INVALID_UTF8",
        "TEXT_TOO_LARGE",
        "TEXT_RESOURCE_BUSY",
        "TEXT_RESULT_INVALID",
        "URL_INVALID",
        "URL_TOO_LONG",
        "PIPELINE_STAGE_FAILED",
        "PROCESSOR_OUTPUT_INVALID",
        "PIPELINE_RECOVERY_REQUIRED",
        "PRIVACY_REVIEW_REQUIRED",
        "PRIVACY_EXPORT_BLOCKED",
        "RESOURCE_LOW_DISK",
        "RESOURCE_MEMORY_PRESSURE",
        "STORAGE_WRITE_FAILED",
        "STORAGE_DIVERGENCE_DETECTED",
        "STORAGE_ARTIFACT_IMMUTABLE",
        "PERSISTENCE_CONFLICT",
        "DEVELOPMENT_RESET_FORBIDDEN"
      ]
    }
  }
}
