{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontextpack.local/schemas/contracts/v1/ocr-result-v1.schema.json",
  "title": "OCRResultV1",
  "$comment": "Structural V1 schema. Cross-field semantic authority: src/domain/validation.ts#isOCRResultV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "text",
    "blocks",
    "durationMs",
    "engine",
    "revision"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "text": { "type": "string", "maxLength": 1000000 },
    "blocks": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/block" }
    },
    "durationMs": { "type": "number", "minimum": 0 },
    "engine": {
      "enum": ["apple-vision", "ml-kit-latin", "ml-kit-chinese"]
    },
    "revision": { "type": "string", "minLength": 1 },
    "recognitionLevel": { "enum": ["accurate", "fast"] },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["OCR_LANGUAGE_FALLBACK", "OCR_LOW_CONFIDENCE"]
      }
    }
  },
  "$defs": {
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1 },
        "y": { "type": "number", "minimum": 0, "maximum": 1 },
        "width": { "type": "number", "minimum": 0, "maximum": 1 },
        "height": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "bounds"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "maxLength": 100000 },
        "bounds": { "$ref": "#/$defs/bounds" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "language": { "type": "string", "minLength": 1 }
      }
    }
  }
}
