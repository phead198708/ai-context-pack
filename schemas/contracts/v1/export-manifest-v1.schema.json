{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aicontextpack.local/schemas/contracts/v1/export-manifest-v1.schema.json",
  "title": "ExportManifestV1",
  "$comment": "Structural V1 schema. Cross-field semantic authority: src/domain/validation.ts#isExportManifestV1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "exportId",
    "packId",
    "createdAt",
    "format",
    "artifacts",
    "privacyReview"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "exportId": { "$ref": "#/$defs/uuid" },
    "packId": { "$ref": "#/$defs/uuid" },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "^\\d{4}-(?:0[1-9]|1[0-2])-(?:0[1-9]|[12]\\d|3[01])T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d{1,9})?Z$"
    },
    "format": {
      "enum": ["markdown", "pdf", "attachment-bundle", "clipboard"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "privacyReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "decisionSetSha256"],
      "properties": {
        "status": { "const": "complete" },
        "decisionSetSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "relativePath",
        "mediaType",
        "byteCount",
        "sha256"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/uuid" },
        "kind": { "enum": ["markdown", "pdf", "attachment"] },
        "relativePath": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*(/[A-Za-z0-9][A-Za-z0-9._-]*)*$"
        },
        "mediaType": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*/[A-Za-z0-9][A-Za-z0-9!#$&^_.+-]*$"
        },
        "byteCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
