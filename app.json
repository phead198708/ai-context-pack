{
  "expo": {
    "name": "AIContextPack",
    "slug": "AIContextPack",
    "scheme": "aicontextpack",
    "version": "1.0.0",
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Select photos to copy into a local Context Pack.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-document-picker"
    ]
  }
}
