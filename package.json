{
  "name": "ai-context-pack",
  "version": "0.0.1",
  "private": true,
  "packageManager": "npm@10.9.2",
  "scripts": {
    "android": "expo run:android",
    "audit:ci": "npm audit --json | node scripts/verify-npm-audit-policy.mjs",
    "doctor": "expo-doctor",
    "ios": "PATH=\"$PWD/scripts/cocoapods-bin:$PATH\" BUNDLE_GEMFILE=\"$PWD/Gemfile\" RUBYOPT=-rlogger expo run:ios",
    "lint": "eslint .",
    "test:fixtures": "node scripts/verify-fixtures.mjs",
    "test:persistence-migrations": "node scripts/verify-persistence-migrations.mjs",
    "test:persistence-production": "node scripts/verify-production-persistence.mjs",
    "test:npm-audit-policy": "node --test scripts/verify-npm-audit-policy.test.mjs",
    "test:v01-verification-policy": "node --test scripts/verify-v01-virtual-verification-policy.test.mjs && node scripts/verify-v01-virtual-verification-policy.mjs",
    "test:workflows": "node scripts/verify-workflow-security.mjs && npm run test:npm-audit-policy && npm run test:v01-verification-policy",
    "start": "expo start --dev-client",
    "test": "jest --runInBand",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@react-native/new-app-screen": "0.86.2",
    "expo": "57.0.11",
    "expo-dev-client": "57.0.10",
    "expo-document-picker": "57.0.1",
    "expo-image-picker": "57.0.8",
    "expo-sqlite": "~57.0.1",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/preset-env": "7.28.6",
    "@babel/runtime": "7.28.6",
    "@expo/cli": "57.0.13",
    "@react-native-community/cli": "20.2.0",
    "@react-native-community/cli-platform-android": "20.2.0",
    "@react-native-community/cli-platform-ios": "20.2.0",
    "@react-native/babel-preset": "0.86.2",
    "@react-native/eslint-config": "0.86.2",
    "@react-native/jest-preset": "0.86.2",
    "@react-native/metro-config": "0.86.2",
    "@react-native/typescript-config": "0.86.2",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.14",
    "@types/react-test-renderer": "19.1.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "eslint": "8.57.1",
    "expo-doctor": "1.20.1",
    "jest": "29.7.0",
    "prettier": "2.8.8",
    "react-test-renderer": "19.2.3",
    "typescript": "6.0.3",
    "yaml": "2.9.0"
  },
  "optionalDependencies": {
    "@expo/metro-config": "57.0.7"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": "^22.13.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}
